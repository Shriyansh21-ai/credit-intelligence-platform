# =============================================================================
# Frontend environment configuration
# =============================================================================
# Copy to `.env` for local development. Only VITE_-prefixed values are exposed
# to the browser bundle — never put secrets here.

# Base URL of the backend API. The client falls back to http://127.0.0.1:8000
# when this is unset, so local development works with no .env at all.
#
# Local:      VITE_API_URL=http://localhost:8000
# Production:  VITE_API_URL=https://YOUR-BACKEND.onrender.com
#
# NOTE: This is baked in at BUILD time (Vite static build). Set it in the Render
# Static Site environment BEFORE the build runs — changing it later requires a
# redeploy. The realtime WebSocket endpoint is derived from this value
# (http->ws, https->wss).
VITE_API_URL=http://localhost:8000
