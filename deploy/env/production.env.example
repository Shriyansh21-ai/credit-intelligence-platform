# =============================================================================
# Deployment profile: PRODUCTION
# =============================================================================
# Strictest profile. The app REFUSES TO START (fails fast) on any fatal
# misconfiguration: insecure/short secrets, SQLite, wildcard CORS, or a backend
# selected without its connection details. Supply every secret from your secret
# manager (KMS-backed Vault/AWS Secrets Manager) — NEVER commit real values.
#
# Generate strong secrets with:  openssl rand -hex 32
# Validate before rollout:       APP_ENV=production python -c "from backend.app.core.startup import validate_configuration as v; v()"
# =============================================================================

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Secrets (inject at deploy time; placeholders MUST be replaced) -----------
SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_32__
JWT_SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_32__
CONNECTOR_MASTER_KEY=__REPLACE_WITH_openssl_rand_hex_32__
ENCRYPTION_KEY=__REPLACE_WITH_openssl_rand_hex_32__
ENCRYPTION_KEY_VERSION=1
SECRETS_PROVIDER=aws

# --- Managed PostgreSQL (high availability) -----------------------------------
DATABASE_URL=postgresql+psycopg://credit:__DB_PASSWORD__@postgres.prod.internal:5432/credit
RUN_MIGRATIONS=0                # run migrations as a gated deploy step, not on boot
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true

# --- Managed Redis ------------------------------------------------------------
CACHE_BACKEND=redis
REDIS_URL=rediss://redis.prod.internal:6379/0
JOB_BROKER=redis

# --- Object storage -----------------------------------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=ai-credit-production
S3_REGION=us-east-1

# --- Explicit browser origins (no wildcards) ----------------------------------
CORS_ORIGINS=https://app.aicreditplatform.com
CORS_ALLOW_CREDENTIALS=true

# --- Security headers (HSTS preload enabled) ----------------------------------
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=63072000
HSTS_PRELOAD=true

# --- Observability ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.prod.internal:4317
OTEL_SERVICE_NAME=ai-credit-platform
TRACING_ENABLED=true
METRICS_ENABLED=true

# --- Mail / LLM / billing -----------------------------------------------------
MAIL_BACKEND=smtp
SMTP_HOST=smtp.prod.internal
SMTP_TLS=true
COPILOT_LLM_PROVIDER=local     # set to `claude` + ANTHROPIC_API_KEY to enable the gated adapter
PAYMENT_GATEWAY=internal

# --- Disaster recovery --------------------------------------------------------
BACKUP_RETENTION_DAYS=35
PITR_WINDOW_DAYS=7
