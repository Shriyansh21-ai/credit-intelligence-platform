# =============================================================================
# Deployment profile: STAGING
# =============================================================================
# Production-like profile: the app FAILS FAST on boot if any insecure default,
# SQLite DSN, wildcard CORS, or half-configured backend is present. Provide all
# secrets from your secret manager (Vault/AWS/…) — never commit real values.
#
# Generate strong secrets with:  openssl rand -hex 32
# =============================================================================

APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Secrets (inject from your secret store; placeholders shown) --------------
SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_32__
JWT_SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_32__
CONNECTOR_MASTER_KEY=__REPLACE_WITH_openssl_rand_hex_32__
ENCRYPTION_KEY=__REPLACE_WITH_openssl_rand_hex_32__
SECRETS_PROVIDER=vault

# --- Managed PostgreSQL (SQLite is rejected in this profile) ------------------
DATABASE_URL=postgresql+psycopg://credit:__DB_PASSWORD__@postgres.staging.internal:5432/credit
RUN_MIGRATIONS=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Managed Redis (required for the redis cache/broker) ----------------------
CACHE_BACKEND=redis
REDIS_URL=redis://redis.staging.internal:6379/0
JOB_BROKER=redis

# --- Object storage -----------------------------------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=ai-credit-staging
S3_REGION=us-east-1

# --- Explicit browser origins (no wildcards) ----------------------------------
CORS_ORIGINS=https://staging.aicreditplatform.com
CORS_ALLOW_CREDENTIALS=true

# --- Security headers ---------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=63072000

# --- Observability / mail / LLM ----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.staging.internal:4317
TRACING_ENABLED=true
METRICS_ENABLED=true
MAIL_BACKEND=smtp
SMTP_HOST=smtp.staging.internal
COPILOT_LLM_PROVIDER=local
