# =============================================================================
# Deployment profile: TESTING
# =============================================================================
# CI / automated-test profile. Fast, hermetic, no external services. Validation
# is advisory (warnings only), like development. Used by the pytest suite and
# the CI test matrix.
# =============================================================================

APP_ENV=testing
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=console

SECRET_KEY=test-insecure-key

# In-memory SQLite keeps tests isolated and fast; migrations run per session.
DATABASE_URL=sqlite:///./credit_ai_test.db
RUN_MIGRATIONS=1

CACHE_BACKEND=memory
JOB_BROKER=in_process
STORAGE_BACKEND=memory

CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

COPILOT_LLM_PROVIDER=local
MAIL_BACKEND=console
METRICS_ENABLED=false
TRACING_ENABLED=false
