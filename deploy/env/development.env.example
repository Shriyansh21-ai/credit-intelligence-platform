# =============================================================================
# Deployment profile: DEVELOPMENT
# =============================================================================
# Local, zero-config developer experience. Copy to `.env` at the repo root:
#   cp deploy/env/development.env.example .env
# Every value here matches the safe defaults, so the app runs with SQLite + an
# in-process cache/broker/storage and a development secret. See the full,
# annotated variable list in the repo-root `.env.example`.
# =============================================================================

APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Zero-config local secret (rejected automatically in staging/production).
SECRET_KEY=dev-insecure-change-me

# SQLite — no external services required.
DATABASE_URL=sqlite:///./credit_ai.db
RUN_MIGRATIONS=1

CACHE_BACKEND=memory
JOB_BROKER=in_process
STORAGE_BACKEND=local

# Local Vite/React dev servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Offline-safe local LLM; console mail; metrics on, tracing off.
COPILOT_LLM_PROVIDER=local
MAIL_BACKEND=console
METRICS_ENABLED=true
TRACING_ENABLED=false
