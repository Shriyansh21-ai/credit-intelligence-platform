# Copy to terraform.tfvars and adjust. NO SECRETS here — only non-sensitive
# configuration. Sensitive values (DB/Redis passwords) are generated by the
# modules and stored in the cloud secret manager.
project      = "ai-credit"
environment  = "dev"
region       = "us-east-1"
domain       = "" # e.g. "dev.ai-credit.example.com" to provision Route53 + ACM
alert_emails = ["platform-oncall@example.com"]
