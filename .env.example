# =============================================================================
# AI Credit Intelligence Platform — environment configuration (Phase 11, M1)
# =============================================================================
# Copy to `.env` for local development. Every value below is optional: with an
# empty environment the platform runs zero-config (SQLite + in-process
# cache/storage/broker + a development secret), so existing local and test
# flows keep working. Set the relevant sections for staging/production.
#
# Profiles: APP_ENV selects development | testing | staging | production.
# In `staging`/`production` the app refuses to start (fails fast) if any of the
# insecure defaults below are left in place — see docs/CONFIGURATION.md.
# =============================================================================

# --- Core --------------------------------------------------------------------
APP_ENV=development                       # development | testing | staging | production
APP_NAME=AI Credit Intelligence Platform
APP_VERSION=1.0
DEBUG=false
# Signing/encryption master secret. MUST be a strong random value in prod:
#   openssl rand -hex 32
SECRET_KEY=dev-insecure-change-me
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                        # console | json  (use json in prod)
# Comma-separated (or JSON array) list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# --- Database ----------------------------------------------------------------
# Zero-config default is SQLite. Use PostgreSQL in staging/production:
#   DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit
DATABASE_URL=sqlite:///./credit_ai.db
RUN_MIGRATIONS=1                          # apply Alembic migrations on start
DB_POOL_SIZE=10                           # (ignored for SQLite)
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- Data provider -----------------------------------------------------------
# Source of company / financial / credit / portfolio data for the seed system
# and the "Load Demo Portfolio" feature. `demo` produces synthetic, clearly
# labelled sample data; `production`/`public` are reserved for real financial
# data providers wired later. The credit/risk engine is agnostic to the source.
DATA_PROVIDER=demo                        # demo | public | production

# --- Cache -------------------------------------------------------------------
CACHE_BACKEND=memory                      # memory | redis
# REDIS_URL=redis://localhost:6379/0      # required when CACHE_BACKEND=redis
CACHE_DEFAULT_TTL=300

# --- Background jobs / messaging ---------------------------------------------
JOB_BROKER=in_process                     # in_process | redis | celery | rabbitmq | kafka
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=ai-credit-platform

# --- Storage -----------------------------------------------------------------
STORAGE_BACKEND=local                     # local | memory | s3 | azure | gcs | minio
STORAGE_ROOT=backend/storage
# S3 (and S3-compatible):
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Azure Blob:
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=
# Google Cloud Storage:
# GCS_BUCKET=
# GCS_CREDENTIALS_JSON=/path/to/service-account.json
# MinIO:
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=ai-credit
MINIO_SECURE=false

# --- Authentication / JWT ----------------------------------------------------
# JWT_SECRET_KEY defaults to SECRET_KEY when unset.
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM / Copilot -----------------------------------------------------------
COPILOT_LLM_PROVIDER=local                # local | claude
COPILOT_CLAUDE_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- Observability -----------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-credit-platform
TRACING_ENABLED=false
METRICS_ENABLED=true

# --- Mail --------------------------------------------------------------------
MAIL_BACKEND=console                      # console | smtp
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=no-reply@ai-credit.local

# --- OCR / Document Intelligence ---------------------------------------------
OCR_ENGINE=auto                           # auto | tesseract | none
# TESSERACT_CMD=/usr/bin/tesseract
MAX_UPLOAD_MB=20

# --- Bank connectors ---------------------------------------------------------
# Master key used to encrypt connector credentials at rest. Random in prod:
#   openssl rand -hex 32
CONNECTOR_MASTER_KEY=dev-master-key-change-me

# --- Billing -----------------------------------------------------------------
PAYMENT_GATEWAY=internal                  # internal | stripe | razorpay
# STRIPE_API_KEY=
# RAZORPAY_API_KEY=

# --- ML ----------------------------------------------------------------------
MODEL_PATH=app/ml/model.pkl
ML_DEFAULT_MODEL=scorecard
ML_EXPLAINER=auto                         # auto | contribution | shap | lime
